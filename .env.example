# ==============================================================================
# Marketplace DIACOM / IC — Exemplo de Variáveis de Ambiente para Deploy
# Copie para .env e substitua TODOS os valores antes de subir em produção:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# ==============================================================================

NODE_ENV=production

POSTGRES_USER=diacom_app
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_DO_POSTGRES
POSTGRES_DB=diacom_loja
DB_SSL=false

# Gere com: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Domínios permitidos no CORS (separados por vírgula, sem barra no final)
CORS_ORIGIN=https://loja.diacom.ic.ufal.br

# URL pública da API consumida pelo navegador no frontend
NEXT_PUBLIC_API_URL=https://api.diacom.ic.ufal.br/api

# Configurações de Cookie HttpOnly e Reverse Proxy
TRUST_PROXY=true
COOKIE_SECURE=true
# Use "lax" se frontend e API compartilharem o mesmo domínio raiz (ex: *.ic.ufal.br);
# use "none" apenas se estiverem em domínios completamente distintos com HTTPS.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CORP_POLICY=same-site

# Bind local para expor apenas ao Reverse Proxy (Nginx / Caddy / Traefik)
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=3001
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=3000

# Administrador inicial (usado apenas se ainda não houver nenhum admin no banco; mín. 12 chars)
ADMIN_EMAIL=admin@diacom.ic.ufal.br
ADMIN_NOME=Coordenação DIACOM
ADMIN_PASSWORD=TROQUE_POR_SENHA_INICIAL_ADMIN_MIN_12_CHARS
